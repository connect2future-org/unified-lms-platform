{
  "name": "pes-lms-platform",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install-client": "npm --prefix client install",
    "install-server": "npm --prefix server install",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "start": "cross-env NODE_ENV=production npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3"
  }
}
