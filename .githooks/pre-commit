#!/bin/sh
# Blocks the commit if derived config drifts from its source.
# Enable once per clone:  git config core.hooksPath .githooks
if command -v pwsh >/dev/null 2>&1; then PS=pwsh
elif command -v powershell >/dev/null 2>&1; then PS=powershell
else echo "pre-commit: PowerShell not found, skipping check" >&2; exit 0; fi

"$PS" -NoProfile -ExecutionPolicy Bypass -File ./tools/sync.ps1 -Check
if [ $? -ne 0 ]; then
  echo "pre-commit: run ./tools/sync.ps1 and stage the result." >&2
  exit 1
fi

"$PS" -NoProfile -ExecutionPolicy Bypass -File ./tools/lint.ps1
if [ $? -ne 0 ]; then
  echo "pre-commit: fix the lint problems above (tools/lint.ps1)." >&2
  exit 1
fi

# Informational only - shows Copilot credit spend for this project. Never blocks.
if [ -f ./tools/report-copilot-credits.ps1 ]; then
  "$PS" -NoProfile -ExecutionPolicy Bypass -File ./tools/report-copilot-credits.ps1 2>/dev/null
fi
exit 0
